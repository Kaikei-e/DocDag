{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/docdag-session-start.sh",
            "timeout": 30,
            "statusMessage": "Checking the decision graph"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/docdag-pre-read.sh",
            "timeout": 10,
            "statusMessage": "Checking if path is DocDag-managed"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/docdag-validate.sh",
            "timeout": 30,
            "statusMessage": "Validating the document graph"
          }
        ]
      }
    ]
  }
}
