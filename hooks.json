{
  "docdag": {
    "SessionStart": [
      {
        "type": "command",
        "command": "./scripts/agy-session-start.sh",
        "timeout": 30
      }
    ],
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file|replace_file_content|multi_replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/agy-post-tool.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "read_file|view_file|find_by_name|grep_search",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/agy-post-tool.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "./scripts/agy-post-invocation.sh",
        "timeout": 10
      }
    ]
  }
}
